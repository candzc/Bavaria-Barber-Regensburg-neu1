---
import Layout from '../layouts/Layout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { business, fullAddress, openingHours } from '../lib/site';

const title = 'Kontakt Bavaria Barber Regensburg – Furtmayrstraße 2';
const description = 'Bavaria Barber Regensburg in der Furtmayrstraße 2, Galgenberg. Ohne Termin vorbeikommen oder anrufen: 0941 74769. Öffnungszeiten und Anfahrt hier.';

const kurzGefragt = [
  {
    q: 'Muss ich einen Termin vereinbaren?',
    a: 'Nein, Sie kommen ohne Termin vorbei und werden der Reihe nach bedient.',
  },
  {
    q: 'Gibt es Parkplätze am Salon?',
    a: 'Ja, direkt vor der Tür in der Furtmayrstraße stehen Parkplätze zur Verfügung.',
  },
  {
    q: 'Wie erreiche ich Sie bei kurzfristigen Fragen?',
    a: `Am schnellsten telefonisch unter ${business.phone} während der Öffnungszeiten.`,
  },
];
---

<Layout title={title} description={description} path="/kontakt" altFont>
  <section class="relative flex min-h-[36vh] items-end overflow-hidden bg-ink">
    <img
      src="/images/placeholder-kontakt-beton-textur.jpg"
      alt="Fein strukturierte, dunkle Betonwand als ruhiger Hintergrund für den Kontaktbereich"
      class="absolute inset-0 h-full w-full object-cover opacity-45"
      width="1600"
      height="1000"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/10"></div>
    <div class="relative mx-auto w-full max-w-6xl px-4 pb-12 pt-24 sm:px-6">
      <h1 class="font-display text-4xl text-paper sm:text-5xl md:text-6xl">
        Kontakt und Anfahrt zu Ihrem Friseur in Regensburg
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-stone-200">
        Sie erreichen Bavaria Barber Regensburg telefonisch, per E-Mail oder direkt vor Ort in der
        Furtmayrstraße 2 am Galgenberg. Einen Termin brauchen Sie nicht – kommen Sie während der Öffnungszeiten
        einfach vorbei und werden der Reihe nach bedient.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Kontakt</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">So erreichen Sie uns</h2>
    <ul class="mx-auto mt-6 max-w-md space-y-2 text-left text-lg text-ink-soft">
      <li><strong class="text-ink">Telefon:</strong> <a href={`tel:${business.phoneHref.replace('tel:', '')}`} class="text-wine underline hover:text-wine-dark">{business.phone}</a></li>
      <li><strong class="text-ink">E-Mail:</strong> <a href={`mailto:${business.email}`} class="text-wine underline hover:text-wine-dark">{business.email}</a></li>
      <li><strong class="text-ink">Adresse:</strong> {fullAddress}</li>
    </ul>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Diese Angaben stimmen mit unserem Google-Unternehmensprofil überein, damit Sie uns überall gleich schnell
      finden.
    </p>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Ansprechpartner</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Ihr Ansprechpartner vor Ort</h2>
      <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
        Inhaber Bakhtiyar Makos führt den Salon seit 2006 und ist gemeinsam mit seinem Team Ihr Ansprechpartner
        für Fragen rund um Haarschnitt, Bartpflege und Termine ohne Voranmeldung.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Anfahrt</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Anfahrt zum Salon am Galgenberg</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Der Salon liegt in der Furtmayrstraße 2 in Regensburg-Galgenberg, direkt mit Parkplätzen vor der Tür
      erreichbar. Die interaktive Karte unten zeigt Ihnen die genaue Lage; sie wird erst nach Ihrer Zustimmung
      geladen, da hierbei eine Verbindung zu einem externen Kartendienst hergestellt wird.
    </p>
    <div class="reveal mx-auto mt-6 max-w-2xl text-left">
      <MapEmbed />
    </div>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Öffnungszeiten</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Öffnungszeiten und Erreichbarkeit</h2>
      <ul class="mx-auto mt-6 max-w-sm space-y-2 text-left text-lg text-ink-soft">
        {openingHours.map((d) => (
          <li class="flex justify-between gap-4 border-b border-stone-200 py-1">
            <span>{d.day}</span>
            <span class="text-ink">{d.hours ?? 'geschlossen'}</span>
          </li>
        ))}
      </ul>
      <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
        Telefonisch sind wir während dieser Zeiten für Fragen erreichbar. Alle Leistungen im Detail finden Sie
        auf der Seite zu <a href="/leistungen" class="text-wine underline hover:text-wine-dark">unseren Leistungen als Herrenfriseur</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Kurz gefragt</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Kurz gefragt: Kontakt und Besuch</h2>
    <div class="mt-10 space-y-4 text-left">
      {kurzGefragt.map((item) => (
        <div class="reveal rounded-card border border-stone-200 bg-paper p-6">
          <p class="font-semibold text-ink">{item.q}</p>
          <p class="mt-2 text-ink-soft">{item.a}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
