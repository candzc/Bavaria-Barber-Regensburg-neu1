---
import Layout from '../layouts/Layout.astro';
import { business } from '../lib/site';

const title = 'Über uns – Bavaria Barber Regensburg seit 2006';
const description = 'Bavaria Barber Regensburg: Seit 2006 am Galgenberg, geführt von Bakhtiyar Makos. Vierköpfiges Team, ein Handwerksverständnis – lernen Sie uns kennen.';

const team = [
  { role: 'Inhaber', note: 'Bakhtiyar Makos — seit 2002 als Friseur tätig, seit 2006 Inhaber des Salons' },
  { role: 'Barber', note: 'Foto folgt in Kürze' },
  { role: 'Barber', note: 'Foto folgt in Kürze' },
  { role: 'Barber', note: 'Foto folgt in Kürze' },
];
---

<Layout title={title} description={description} path="/ueber-uns">
  <section class="relative flex min-h-[46vh] items-end overflow-hidden bg-ink">
    <img
      src="/images/placeholder-ueber-uns-ziegel-textur.jpg"
      alt="Schwarz-weiß fotografierte, verwitterte Ziegelwand als Symbol für Handwerk mit Geschichte"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      width="1600"
      height="1067"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/10"></div>
    <div class="relative mx-auto w-full max-w-6xl px-4 pb-14 pt-28 sm:px-6">
      <h1 class="font-display text-4xl text-paper sm:text-5xl md:text-6xl">
        Über uns – Bavaria Barber Regensburg seit 2006
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Über uns</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Wer hinter Bavaria Barber Regensburg steht</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Bavaria Barber Regensburg ist ein Herrenfriseur-Salon am Galgenberg für Herren und Kinder jeden Alters, die
      Wert auf einen präzisen Schnitt ohne langes Warten legen. Geführt wird der Salon von Bakhtiyar Makos, der
      seit 2002 als Friseur arbeitet und seit 2006 seinen eigenen Betrieb in der Furtmayrstraße führt.
    </p>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Team</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Das Team am Galgenberg</h2>
      <p class="reveal mx-auto mt-6 max-w-3xl text-left text-lg leading-relaxed text-ink-soft">
        Vier Friseure arbeiten bei Bavaria Barber Regensburg täglich mit demselben Anspruch an Präzision. Echte
        Team-Fotos folgen in Kürze — bis dahin stellen wir das Team hier bewusst textlich vor, statt Stockfotos
        fremder Personen zu zeigen.
      </p>
      <ul class="mt-10 grid gap-5 text-left sm:grid-cols-2 lg:grid-cols-4">
        {team.map((member) => (
          <li class="reveal rounded-card border border-stone-200 bg-paper p-6 text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-wine/10 text-wine" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
            </div>
            <p class="mt-3 text-sm font-semibold text-ink">{member.role}</p>
            <p class="mt-1 text-xs text-ink-soft">{member.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Geschichte</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Die Geschichte des Salons seit 2006</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      2006 eröffnete Bakhtiyar Makos seinen eigenen Salon in der Furtmayrstraße, nachdem er sein Handwerk bereits
      seit 2002 als Friseur ausgeübt hatte. Aus dem klassischen Herrenschnitt wuchs über die Jahre ein breites
      Können, das heute auch moderne Techniken wie Fade und Undercut umfasst — Wissen, das im Salon direkt an das
      Team weitergegeben wird.
    </p>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Werte</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Wofür Bavaria Barber Regensburg steht</h2>
      <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
        Ein präziser Schnitt soll nicht an einem langen Termin-Vorlauf scheitern. Deshalb arbeitet Bavaria Barber
        ohne Terminzwang, mit kurzen Wegen — Parkplätze direkt vor der Tür — und einem Team, das dasselbe
        Handwerksverständnis teilt wie der Inhaber selbst.
      </p>
      <ul class="mx-auto mt-6 max-w-2xl space-y-3 text-left text-ink-soft">
        <li class="reveal flex gap-3"><span class="text-wine">—</span> Präzision bei jedem Schnitt, unabhängig davon, welcher Friseur bedient</li>
        <li class="reveal flex gap-3"><span class="text-wine">—</span> Kurze Wege statt langer Wartezeit oder Terminplanung</li>
        <li class="reveal flex gap-3"><span class="text-wine">—</span> Handwerk, das im Team weitergegeben und gepflegt wird</li>
      </ul>
    </div>
  </section>

  <section class="bg-wine">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6">
      <p class="font-display text-xl text-paper sm:text-2xl">Lernen Sie das Team persönlich kennen</p>
      <a href={`tel:${business.phoneHref.replace('tel:', '')}`} class="mt-6 inline-flex min-h-[48px] items-center rounded-full bg-paper px-7 text-base font-semibold text-wine hover:bg-stone-200">
        {business.phone} anrufen
      </a>
    </div>
  </section>
</Layout>
