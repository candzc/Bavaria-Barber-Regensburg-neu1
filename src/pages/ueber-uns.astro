---
import Layout from '../layouts/Layout.astro';
import { business } from '../lib/site';
import { LiquidMetalButton } from '../components/LiquidMetalButton';

const title = 'Über uns – Bavaria Barber Regensburg seit 2006';
const description = 'Bavaria Barber Regensburg: Seit 2006 am Galgenberg, geführt von Bakhtiyar Makos. Vierköpfiges Team, ein Handwerksverständnis – lernen Sie uns kennen.';

const werte = [
  { title: 'Präzision', text: 'jeder Schnitt wird sorgfältig ausgeführt, bis er wirklich passt' },
  { title: 'Zuverlässigkeit', text: 'gleichbleibende Qualität bei jedem Besuch und jedem Friseur' },
  { title: 'Offenheit', text: 'kurzes Gespräch vor dem Schnitt statt Standardprogramm' },
  { title: 'Erfahrung', text: 'über 20 Jahre Handwerk, weitergegeben an das gesamte Team' },
];
---

<Layout title={title} description={description} path="/ueber-uns" altFont>
  <section class="relative flex min-h-[46vh] items-end overflow-hidden bg-ink">
    <img
      src="/images/ueber-uns-bakhtiyar-hero.jpg"
      alt="Bakhtiyar Makos schneidet im Salon Bavaria Barber Regensburg einem Kunden die Haare"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
      width="1920"
      height="1280"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/10"></div>
    <div class="relative mx-auto w-full max-w-6xl px-4 pb-14 pt-28 sm:px-6">
      <h1 class="font-display text-4xl text-paper sm:text-5xl md:text-6xl">
        Ihr Friseur-Team am Galgenberg in Regensburg
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-stone-200">
        Seit 2006 schneidet unser Team am Galgenberg Herren die Haare, pflegt Bärte und arbeitet vom klassischen
        Kurzhaarschnitt bis zu modernen Fade-Techniken. Bakhtiyar Makos hat den Salon aufgebaut und sein Handwerk
        direkt an sein Team weitergegeben. Lernen Sie die Menschen hinter Bavaria Barber Regensburg kennen.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Über uns</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Wer wir sind und für wen wir arbeiten</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Bei uns arbeitet ein vierköpfiges Team, das Herren jeden Alters bedient und auf Wunsch auch Kindern die
      Haare schneidet. Die volle Übersicht unserer Leistungen finden Sie auf der Seite zu <a href="/leistungen" class="text-wine underline hover:text-wine-dark">unseren Leistungen als Herrenfriseur</a>.
    </p>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto grid max-w-5xl gap-10 px-4 py-20 sm:px-6 sm:py-24 md:grid-cols-2 md:items-center">
      <div class="reveal order-2 text-center md:order-1 md:text-left">
        <span class="eyebrow">Geschichte</span>
        <h2 class="mt-3 font-display text-2xl text-ink sm:text-3xl">Vom Auszubildenden zum eigenen Salon</h2>
        <p class="mt-6 text-lg leading-relaxed text-ink-soft">
          Bakhtiyar Makos begann seine Laufbahn 2002 in einem bekannten Regensburger Friseursalon. 2006 eröffnete er
          mit Bavaria Barber seinen ersten eigenen Salon in der Furtmayrstraße, den es dort bis heute gibt. 2016
          folgte mit dem Makosan Haarstudio in der Maximilianstraße ein zweiter Standort in der Innenstadt, den er
          ebenfalls führt.
        </p>
      </div>
      <div class="reveal order-1 aspect-[3/2] overflow-hidden rounded-card md:order-2">
        <img
          src="/images/ueber-uns-bakhtiyar-geschichte.jpg"
          alt="Bakhtiyar Makos, Inhaber von Bavaria Barber Regensburg, beim Haareschneiden im Salon"
          class="h-full w-full object-cover"
          width="1200"
          height="800"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Werte</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Wofür Bavaria Barber Regensburg steht</h2>
    <ul class="mx-auto mt-6 max-w-2xl space-y-3 text-left text-ink-soft">
      {werte.map((w) => (
        <li class="reveal flex gap-3"><span class="text-wine">—</span> <span><strong class="text-ink">{w.title}</strong> – {w.text}</span></li>
      ))}
    </ul>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Team</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Ein Team, das zusammenarbeitet</h2>
      <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
        Unser Team arbeitet seit Jahren zusammen und tauscht sich laufend über Techniken aus. So bekommen Sie
        dieselbe Qualität, ganz gleich, wer gerade frei ist.
      </p>
    </div>
  </section>

  <section class="bg-wine">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6">
      <p class="font-display text-xl text-paper sm:text-2xl">Lernen Sie Ihr neues Friseur-Team kennen</p>
      <p class="mx-auto mt-2 max-w-2xl text-stone-200">
        Kommen Sie ohne Termin in die Furtmayrstraße 2 in Regensburg-Galgenberg vorbei und lernen Sie unser Team
        persönlich kennen. Alle Kontaktdaten und die Anfahrt finden Sie über den Link <a href="/kontakt" class="text-paper underline hover:text-stone-200">Kontakt und Anfahrt am Galgenberg</a>.
      </p>
      <div class="mt-6 flex justify-center">
        <LiquidMetalButton
          client:idle
          label={`${business.phone} anrufen`}
          href={`tel:${business.phoneHref.replace('tel:', '')}`}
          variant="dark"
        />
      </div>
    </div>
  </section>
</Layout>
