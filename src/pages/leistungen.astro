---
import Layout from '../layouts/Layout.astro';
import { business } from '../lib/site';
import { serviceSchema } from '../lib/schema';

const title = 'Herrenfriseur Regensburg – Leistungen bei Bavaria Barber';
const description = 'Herrenfriseur in Regensburg: Klassischer Schnitt, Taper Fade, Undercut, Bartpflege und Kinderhaarschnitte. Ohne Termin am Galgenberg – jetzt vorbeikommen.';

const jsonLd = [
  serviceSchema({
    name: 'Herrenfriseur-Leistungen',
    description: 'Klassischer Herrenschnitt, Fade-Techniken, Bartpflege und Kinderhaarschnitte bei Bavaria Barber Regensburg.',
  }),
];

const services = [
  {
    title: 'Klassischer Herrenschnitt',
    text: 'Der zeitlose Schnitt mit Schere und Maschine, sauber ausgearbeitet an Konturen und Übergängen — die Grundlage unseres Handwerks seit 2006.',
  },
  {
    title: 'Taper Fade & Undercut',
    text: 'Weiche oder scharfe Übergänge an den Seiten, kombiniert mit mehr Länge oben — präzise gearbeitet für einen modernen, gepflegten Look.',
  },
  {
    title: 'Buzz Cut & Crew Cut',
    text: 'Kurz, pflegeleicht und gleichmäßig gearbeitet — die richtige Wahl für alle, die es unkompliziert und sauber mögen.',
  },
  {
    title: 'Mullet & moderne Trendschnitte',
    text: 'Auch aktuelle Trendschnitte wie den Mullet setzen unsere Friseure sicher um, abgestimmt auf Kopfform und Haarstruktur.',
  },
  {
    title: 'Bartpflege & scharfe Konturen',
    text: 'Bartschnitt, Kontur und Formgebung als eigenständige Leistung oder in Kombination mit dem Haarschnitt.',
  },
  {
    title: 'Kinderhaarschnitte',
    text: 'Herren und Kinder jeden Alters sind bei uns willkommen — mit demselben Anspruch an Präzision wie beim Erwachsenenschnitt.',
  },
];
---

<Layout title={title} description={description} path="/leistungen" jsonLd={jsonLd}>
  <section class="relative flex min-h-[46vh] items-end overflow-hidden bg-ink">
    <img
      src="/images/placeholder-leistungen-barber-tools.jpg"
      alt="Goldener Rasiermesser-Griff, Schere und Kamm liegen ordentlich auf schwarzem Stoff im Barbershop"
      class="absolute inset-0 h-full w-full object-cover opacity-45"
      width="1600"
      height="1067"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/10"></div>
    <div class="relative mx-auto w-full max-w-6xl px-4 pb-14 pt-28 sm:px-6">
      <h1 class="font-display text-3xl leading-tight text-paper sm:text-4xl md:text-5xl">
        Herrenfriseur Regensburg – Leistungen bei Bavaria Barber
      </h1>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <h2 class="reveal font-display text-2xl text-ink sm:text-3xl">Was Bavaria Barber Regensburg als Herrenfriseur leistet</h2>
    <p class="reveal mt-4 text-lg leading-relaxed text-ink-soft">
      Bavaria Barber Regensburg ist Ihr Herrenfriseur am Galgenberg für klassische Schnitte, moderne Fade-Techniken
      und Bartpflege — ohne Termin, mit kurzer Wartezeit. Unser vierköpfiges Team arbeitet seit 2006 in der
      Furtmayrstraße und bringt jede Frisur präzise auf den Punkt, für Herren und Kinder jeden Alters.
    </p>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <h2 class="reveal font-display text-2xl text-ink sm:text-3xl">Was Sie von jedem Besuch bei uns erwarten können</h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-ink-soft">
        Jeder Schnitt bei Bavaria Barber Regensburg entsteht mit demselben Anspruch an Präzision, egal welcher
        der vier Friseure Sie bedient. Dazu kommen kurze Wege: Der Salon liegt mit Parkplätzen direkt vor der Tür
        in der Furtmayrstraße, und ein Besuch ist ohne vorherige Terminbuchung möglich.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="reveal font-display text-2xl text-ink sm:text-3xl">Unsere Leistungen als Herrenfriseur im Überblick</h2>
    <p class="reveal mt-4 max-w-3xl text-lg leading-relaxed text-ink-soft">
      Die folgende Übersicht zeigt die Schnitte und Leistungen, die unser Team bei Bavaria Barber Regensburg
      regelmäßig für Herren und Kinder umsetzt.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {services.map((s) => (
        <article class="reveal rounded-card border border-stone-200 bg-paper p-6 transition-all duration-200 hover:-translate-y-1 hover:border-wine hover:shadow-lg">
          <h3 class="text-lg font-semibold text-ink">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <h2 class="reveal font-display text-2xl text-ink sm:text-3xl">So läuft Ihr Besuch bei Bavaria Barber ab</h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-ink-soft">
        Sie kommen während der Öffnungszeiten vorbei, nennen kurz Ihren Wunsch und werden der Reihe nach von
        einem unserer vier Friseure bedient. Eine vorherige Terminbuchung ist nicht nötig — an stark
        frequentierten Tagen wie Samstagvormittag kann die Wartezeit etwas länger ausfallen.
      </p>
    </div>
  </section>

  <section class="bg-wine">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6">
      <p class="font-display text-xl text-paper sm:text-2xl">Bereit für Ihren nächsten Schnitt?</p>
      <p class="mx-auto mt-2 max-w-2xl text-stone-200">
        Kommen Sie spontan in die Furtmayrstraße 2 in Regensburg-Galgenberg oder rufen Sie uns bei Fragen an.
      </p>
      <a href={`tel:${business.phoneHref.replace('tel:', '')}`} class="mt-6 inline-flex min-h-[48px] items-center rounded-sm bg-paper px-7 text-base font-semibold text-wine hover:bg-stone-200">
        {business.phone} anrufen
      </a>
    </div>
  </section>
</Layout>
