---
import Layout from '../layouts/Layout.astro';
import { business } from '../lib/site';
import { serviceSchema } from '../lib/schema';
import { LiquidMetalButton } from '../components/LiquidMetalButton';
import LeistungenFan from '../components/LeistungenFan.astro';

const title = 'Herrenfriseur Regensburg – Leistungen bei Bavaria Barber';
const description = 'Herrenfriseur in Regensburg: Klassischer Schnitt, Taper Fade, Undercut, Bartpflege und Kinderhaarschnitte. Ohne Termin am Galgenberg – jetzt vorbeikommen.';

const jsonLd = [
  serviceSchema({
    name: 'Haarschnitt, Bartpflege, Gesichtspflege und Kombipakete',
    description: 'Haarschnitt mit Waschen, Schneiden und Föhnen, Bartpflege von der Nassrasur bis zur Kontur, Gesichtspflege mit Fadentechnik und Warmwachs sowie Kombipakete bei Bavaria Barber Regensburg.',
  }),
];

// Bild je Karte: aktuell noch bestehende Platzhalter (echte Salon-/
// Frisurfotos wurden im Chat gezeigt, liegen als Datei aber noch nicht vor —
// werden hier eingesetzt, sobald sie tatsächlich übernommen werden können).
const leistungsbereiche = [
  {
    title: 'Haarschnitt mit Waschen, Schneiden und Föhnen',
    text: 'Ihr Haarschnitt umfasst Waschen, Schneiden und Föhnen, ob kurz, mittellang oder lang. Auf Wunsch rundet eine Kopfmassage den Besuch ab. Vom klassischen Kurzhaarschnitt bis zu Taper Fade oder Undercut setzen wir Ihren Wunsch-Look um.',
    image: '/images/placeholder-leistungen-barber-tools.jpg',
    alt: 'Barber-Werkzeuge für den Haarschnitt bei Bavaria Barber Regensburg',
  },
  {
    title: 'Bartpflege von der Nassrasur bis zur Kontur',
    text: 'Zur Bartpflege gehören klassische Nassrasur, Bart-Maschinenschnitt und die komplette Behandlung mit Maschinenschnitt, Konturen und Nassrasur. Sie entscheiden, ob eine kurze Auffrischung reicht oder die vollständige Pflege gewünscht ist.',
    image: '/images/placeholder-leistungen-teaser-tools.jpg',
    alt: 'Scheren für Konturen und Bartpflege bei Bavaria Barber Regensburg',
  },
  {
    title: 'Gesichtspflege mit Fadentechnik und Warmwachs',
    text: 'Zur Gesichtspflege zählen Augenbrauen zupfen in Fadentechnik sowie Haarentfernung mit Warmwachs an Nase, Ohren oder im gesamten Gesicht. Diese Leistungen buchen Sie einzeln oder kombiniert mit Haarschnitt und Bartpflege.',
    image: '/images/placeholder-hero-holz-textur.jpg',
    alt: 'Gesichtspflege-Bereich bei Bavaria Barber Regensburg',
  },
  {
    title: 'Kombipakete für Haarschnitt, Bart und Gesicht',
    text: 'Unsere Pakete bündeln Waschen, Schneiden, Föhnen und Kopfmassage mit Augenbrauen zupfen oder Gesichtshaarentfernung. Die umfangreichste Variante ergänzt zusätzlich Nassrasur und eine Kopfmassage mit Haarwasser.',
    image: '/images/placeholder-ueber-uns-ziegel-textur.jpg',
    alt: 'Kombipaket-Behandlung bei Bavaria Barber Regensburg',
  },
];
---

<Layout title={title} description={description} path="/leistungen" jsonLd={jsonLd} altFont>
  <section class="relative flex min-h-[46vh] items-end overflow-hidden bg-ink">
    <img
      src="/images/placeholder-leistungen-barber-tools.jpg"
      alt="Goldener Rasiermesser-Griff, Schere und Kamm liegen ordentlich auf schwarzem Stoff im Barbershop"
      class="absolute inset-0 h-full w-full object-cover opacity-45"
      width="1600"
      height="1067"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/10"></div>
    <div class="relative mx-auto w-full max-w-6xl px-4 pb-14 pt-28 sm:px-6">
      <h1 class="font-display text-4xl text-paper sm:text-5xl md:text-6xl">
        Herrenfriseur Regensburg – Haarschnitt, Bart und Gesichtspflege
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-stone-200">
        Als Herrenfriseur in Regensburg schneiden wir mehr als nur Haare – Bart und Gesicht gehören dazu. Am
        Galgenberg bekommen Sie Haarschnitt, Bartpflege und Gesichtspflege aus einer Hand, inklusive Waschen,
        Föhnen und auf Wunsch einer Kopfmassage. Viele Friseure haben ihr Handwerk bei uns gelernt, einige sind
        heute selbst mit eigenem Salon selbstständig – diese Erfahrung fließt in jeden Schnitt ein.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Leistungen</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Vier Leistungsbereiche aus einer Hand</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Wir bieten Haarschnitt, Bartpflege, Gesichtspflege und Kombipakete, die mehrere Leistungen bündeln. So sparen
      Sie sich einen zweiten Termin bei einem separaten Kosmetikstudio für die Augenbrauen. Die Details zu jeder
      Leistung finden Sie im Folgenden.
    </p>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Im Detail</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Was in jeder Leistung enthalten ist</h2>
      <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
        Jede Leistung führen wir mit dem gleichen Anspruch an Sorgfalt aus, ob Sie nur kurz zum Waschen und
        Schneiden kommen oder ein komplettes Paket wünschen.
      </p>
      <LeistungenFan items={leistungsbereiche} />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Vor Ort</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">So läuft Ihr Besuch bei uns ab</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Sie kommen ohne Termin vorbei und werden der Reihe nach bedient. Nach kurzer Absprache zum Wunsch-Schnitt
      führen wir die Behandlung in einem Durchgang aus, bis das Ergebnis passt.
    </p>
  </section>

  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Vorteile</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Warum Kunden zu uns zurückkommen</h2>
      <ul class="mx-auto mt-6 max-w-2xl space-y-3 text-left text-ink-soft">
        <li class="reveal flex gap-3"><span class="text-wine">—</span> <span><strong class="text-ink">Alles aus einer Hand</strong> – Haarschnitt, Bartpflege und Gesichtspflege in einem Termin</span></li>
        <li class="reveal flex gap-3"><span class="text-wine">—</span> <span><strong class="text-ink">Spontan buchbar</strong> – ohne Terminzwang vorbeikommen</span></li>
        <li class="reveal flex gap-3"><span class="text-wine">—</span> <span><strong class="text-ink">Parkplätze direkt vor der Tür</strong></span></li>
      </ul>
    </div>
  </section>

  <section class="bg-wine">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center sm:px-6">
      <p class="font-display text-xl text-paper sm:text-2xl">Vereinbaren Sie jetzt Ihren Besuch</p>
      <p class="mx-auto mt-2 max-w-2xl text-stone-200">
        Kommen Sie in die Furtmayrstraße 2 in Regensburg-Galgenberg oder rufen Sie unter {business.phone} an.
        Kontaktdaten und Anfahrt finden Sie über den Link <a href="/kontakt" class="text-paper underline hover:text-stone-200">Kontakt und Anfahrt am Galgenberg</a>.
      </p>
      <div class="mt-6 flex justify-center">
        <LiquidMetalButton
          client:idle
          label={`${business.phone} anrufen`}
          href={`tel:${business.phoneHref.replace('tel:', '')}`}
          variant="dark"
        />
      </div>
    </div>
  </section>
</Layout>
