---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { LiquidMetalButton } from '../components/LiquidMetalButton';
import { GlowyWavesHero } from '../components/GlowyWavesHero';
import { FaqAccordion, homeFaqData } from '../components/FaqAccordion';
import TestimonialsFan from '../components/TestimonialsFan.astro';
import { business, fullAddress, usps, partnerSalon } from '../lib/site';
import { serviceSchema } from '../lib/schema';

const title = 'Barber Regensburg – Herrenfriseur am Galgenberg | Bavaria Barber';
const description = 'Barber in Regensburg-Galgenberg: Herrenschnitt, Fade & Bartpflege ohne Termin. Seit 2006 in der Furtmayrstraße. Jetzt spontan vorbeikommen oder anrufen.';

// Passende Icons + wechselnde Akzentfarbe (Gold/Weinrot-Soft) je Vorteil,
// statt des bisher immer gleichen Häkchens — macht die Karten auf einen
// Blick unterscheidbar statt gleichförmig.
const uspIcons = [
  { bgClass: 'bg-gold/20', textClass: 'text-gold', glowClass: 'bg-gold/30', path: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>' }, // Erfahrung: Uhr
  { bgClass: 'bg-wine-soft/25', textClass: 'text-wine-soft', glowClass: 'bg-wine/40', path: '<path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z"/>' }, // Spontan: Blitz
  { bgClass: 'bg-gold/20', textClass: 'text-gold', glowClass: 'bg-gold/30', path: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2"/><path d="M9 2h6"/>' }, // Wartezeiten: Stoppuhr
  { bgClass: 'bg-wine-soft/25', textClass: 'text-wine-soft', glowClass: 'bg-wine/40', path: '<path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>' }, // Parkplätze: Pin
  { bgClass: 'bg-gold/20', textClass: 'text-gold', glowClass: 'bg-gold/30', path: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2 20c0-3 3-5 7-5s7 2 7 5"/><path d="M16 15c3 0 6 2 6 5"/>' }, // Team
];

const jsonLd = [
  serviceSchema({
    name: 'Herrenhaarschnitt und Bartpflege',
    description: 'Klassischer Herrenschnitt, moderne Fade-Techniken und Bartpflege für Herren und Kinder in Regensburg-Galgenberg.',
  }),
];
---

<Layout title={title} description={description} path="/" jsonLd={jsonLd} altFont>
  <Hero />

  <!-- Vertrauen & Informationsvermittlung -->
  <GlowyWavesHero client:visible />

  <!-- Konkreter Kundennutzen -->
  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Kundennutzen</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Über 20 Jahre Friseur-Erfahrung am Galgenberg</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Bakhtiyar Makos schneidet seit 2002 Haare in Regensburg und führt seit 2006 seinen eigenen Salon in der
      Furtmayrstraße. In dieser Zeit hat er sich vom klassischen Herrenschnitt bis zu modernen Techniken wie
      Fade und Undercut ein breites Können angeeignet. Dieses Wissen gibt er im Salon täglich an sein Team weiter.
    </p>
    <p class="reveal mx-auto mt-4 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Bakhtiyar Makos führt außerdem das <a href={partnerSalon.url} target="_blank" rel="noopener" class="text-wine underline hover:text-wine-dark">{partnerSalon.name}</a> in
      der Regensburger Maximilianstraße, eröffnet 2016 — mit demselben Handwerksverständnis wie am Galgenberg.
    </p>
  </section>

  <!-- Leistungen Preview -->
  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 sm:py-24 md:grid-cols-2 md:items-center">
      <div class="reveal order-2 md:order-1">
        <span class="eyebrow">Leistungen</span>
        <h2 class="mt-3 font-display text-2xl text-ink sm:text-3xl">Herrenhaarschnitt, Bartpflege und moderne Fade-Techniken</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          Bei Bavaria Barber Regensburg schneiden unsere Friseure klassische Herrenschnitte genauso sicher wie
          Taper Fade, Undercut, Buzz Cut, Crew Cut oder Mullet. Auch Bartpflege und scharfe Konturen zählen zum
          täglichen Handwerk unseres vierköpfigen Teams. Auf Wunsch schneiden wir auch Ihrem Sohn die Haare, mit
          demselben Anspruch an Präzision.
        </p>
        <a href="/leistungen" class="mt-6 inline-flex min-h-[48px] items-center text-base font-semibold text-wine underline hover:text-wine-dark">
          Alle Leistungen als Herrenfriseur ansehen
        </a>
      </div>
      <div class="reveal order-1 aspect-[4/3] overflow-hidden rounded-card md:order-2">
        <img
          src="/images/placeholder-leistungen-teaser-tools.jpg"
          alt="Friseurscheren in verschiedenen Ausführungen für Konturen und Übergänge, aufgereiht auf einem hellen Handtuch"
          class="h-full w-full object-cover"
          width="1200"
          height="800"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- CTA früh -->
  <section class="blend-top bg-wine [--blend-from:var(--color-paper-dim)]">
    <div class="mx-auto max-w-6xl px-4 py-12 text-center sm:px-6 sm:py-14">
      <p class="font-display text-xl text-paper sm:text-2xl">Spontan vorbeikommen statt Termin vereinbaren</p>
      <p class="mx-auto mt-2 max-w-2xl text-stone-200">
        Sie kommen während der Öffnungszeiten einfach vorbei und werden der Reihe nach bedient, meist innerhalb
        kurzer Wartezeit. An stark frequentierten Tagen wie Samstagvormittag kann sich die Wartezeit verlängern.
      </p>
      <div class="mt-6 flex justify-center">
        <LiquidMetalButton
          client:idle
          label={`${business.phone} anrufen`}
          href={`tel:${business.phoneHref.replace('tel:', '')}`}
          variant="dark"
        />
      </div>
    </div>
  </section>

  <!-- Über uns Preview -->
  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <span class="eyebrow reveal">Über uns</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Ein Handwerk, das im Team weiterlebt</h2>
    <p class="reveal mx-auto mt-6 max-w-2xl text-left text-lg leading-relaxed text-ink-soft">
      Was als Lehre begann, ist heute die Grundlage für jeden Schnitt bei Bavaria Barber Regensburg. Bakhtiyar
      Makos gibt sein Können im Salon direkt an sein Team weiter, damit Sie bei jedem der vier Friseure dieselbe
      Qualität bekommen.
    </p>
    <a href="/ueber-uns" class="reveal mt-6 inline-flex min-h-[48px] items-center text-base font-semibold text-wine underline hover:text-wine-dark">
      Die Geschichte des Salons und das Team kennenlernen
    </a>
  </section>

  <!-- Vorteile / USPs: dunkle Glow-Karten (Referenz: "Wir lernen Ihr
       Geschäft kennen") — Weinrot statt Rot, echte USP-Inhalte aus site.ts -->
  <section class="blend-top border-t border-stone-200 bg-ink [--blend-from:var(--color-paper)]">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">Vorteile</span>
      <h2 class="reveal mt-3 font-display text-2xl text-paper sm:text-3xl">Was Bavaria Barber Regensburg für Sie leistet</h2>
      <ul class="mt-10 grid gap-5 text-left sm:grid-cols-2 lg:grid-cols-3">
        {usps.map((usp, i) => {
          const icon = uspIcons[i % uspIcons.length];
          return (
            <li class="reveal group relative overflow-hidden rounded-card border border-paper/10 bg-stone-800/60 p-7 text-paper backdrop-blur-sm transition-all duration-200 hover:-translate-y-1 hover:border-wine-soft/60 hover:shadow-2xl">
              <div
                class:list={['pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full blur-3xl transition-opacity duration-300 group-hover:opacity-80', icon.glowClass]}
                aria-hidden="true"
              ></div>
              <div class:list={['relative flex h-10 w-10 items-center justify-center rounded-full', icon.bgClass, icon.textClass]} aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.path} />
              </div>
              <p class="font-display relative mt-4 text-lg text-paper">{usp.title}</p>
              <p class="relative mt-2 text-sm leading-relaxed text-stone-400">{usp.text}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="blend-top mx-auto max-w-6xl overflow-hidden px-4 py-20 text-center sm:px-6 sm:py-24 [--blend-from:var(--color-ink)]">
    <span class="eyebrow reveal">Kundenstimmen</span>
    <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Das sagen Kunden über ihren Besuch am Galgenberg</h2>
    <TestimonialsFan />
  </section>

  <!-- FAQ -->
  <section class="border-t border-stone-200 bg-paper-dim">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <span class="eyebrow reveal">FAQ</span>
      <h2 class="reveal mt-3 font-display text-2xl text-ink sm:text-3xl">Häufige Fragen zum Barber am Galgenberg</h2>

      <div class="reveal mt-10">
        <FaqAccordion client:visible data={homeFaqData} className="mx-auto max-w-2xl p-0" />
      </div>
    </div>
  </section>

  <!-- CTA wiederholt -->
  <section class="blend-top bg-ink [--blend-from:var(--color-paper-dim)]">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <h2 class="font-display text-2xl text-paper sm:text-3xl">So erreichen Sie Ihren Barber in Regensburg</h2>
      <p class="mx-auto mt-4 max-w-2xl text-stone-200">
        Sie erreichen Bavaria Barber Regensburg telefonisch unter {business.phone} oder kommen direkt in die{' '}
        {fullAddress}. Alle Kontaktdaten und die Anfahrt im Detail finden Sie auf der{' '}
        <a href="/kontakt" class="text-paper underline hover:text-stone-200">Kontaktseite mit Anfahrt am Galgenberg</a>.
      </p>
      <div class="mt-6 flex justify-center">
        <LiquidMetalButton
          client:idle
          label={`${business.phone} anrufen`}
          href={`tel:${business.phoneHref.replace('tel:', '')}`}
          variant="dark"
        />
      </div>
    </div>
  </section>
</Layout>
