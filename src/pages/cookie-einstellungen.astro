---
import Layout from '../layouts/Layout.astro';

const title = 'Cookie-Einstellungen – Bavaria Barber Regensburg';
const description = 'Verwalten Sie Ihre Cookie-Einstellungen für Bavaria Barber Regensburg. Widerruf jederzeit möglich, genauso einfach wie die Zustimmung.';
---

<Layout title={title} description={description} path="/cookie-einstellungen">
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-3xl text-ink sm:text-4xl">Cookie-Einstellungen</h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-soft">
      Notwendige Funktionen und die cookielose Analyse über Cloudflare laufen immer. Die interaktive
      Google-Maps-Karte auf der Kontaktseite lädt nur mit Ihrer Zustimmung. Sie können Ihre Wahl hier jederzeit
      ändern.
    </p>

    <div class="mt-8 space-y-4 rounded-card border border-stone-200 bg-paper-dim p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold text-ink">Notwendig</p>
          <p class="text-sm text-ink-soft">Grundfunktionen der Website und cookielose Cloudflare-Analyse. Immer aktiv.</p>
        </div>
        <span class="mt-1 inline-flex min-h-[32px] items-center rounded-full bg-stone-200 px-3 text-xs font-semibold text-ink-soft">Immer an</span>
      </div>
      <div class="flex items-start justify-between gap-4 border-t border-stone-200 pt-4">
        <div>
          <p class="font-semibold text-ink">Externe Inhalte (Google Maps)</p>
          <p class="text-sm text-ink-soft">Lädt die interaktive Anfahrtskarte auf der Kontaktseite von Google.</p>
        </div>
        <button id="toggle-maps" type="button" class="min-h-[48px] rounded-full border border-stone-400 px-4 text-sm font-semibold text-ink hover:border-wine" aria-pressed="false">
          Aktivieren
        </button>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <button id="save-settings" type="button" class="min-h-[48px] rounded-full bg-wine px-6 text-sm font-semibold text-paper hover:bg-wine-dark">
        Einstellungen speichern
      </button>
      <button id="revoke-all" type="button" class="min-h-[48px] rounded-full border border-stone-400 px-6 text-sm font-semibold text-ink-soft hover:border-ink">
        Alles widerrufen
      </button>
    </div>
    <p id="save-confirmation" class="mt-3 hidden text-sm text-wine" role="status">Ihre Einstellungen wurden gespeichert.</p>
  </section>

  <script>
    type Consent = { necessary: true; maps: boolean };
    const KEY = 'cookie-consent';

    function readConsent(): Consent {
      try {
        const raw = localStorage.getItem(KEY);
        return raw ? (JSON.parse(raw) as Consent) : { necessary: true, maps: false };
      } catch {
        return { necessary: true, maps: false };
      }
    }

    function writeConsent(consent: Consent) {
      localStorage.setItem(KEY, JSON.stringify(consent));
      document.dispatchEvent(new CustomEvent('cookie-consent-changed', { detail: consent }));
    }

    const toggleBtn = document.getElementById('toggle-maps') as HTMLButtonElement | null;
    let current = readConsent();

    function render() {
      if (!toggleBtn) return;
      toggleBtn.textContent = current.maps ? 'Deaktivieren' : 'Aktivieren';
      toggleBtn.setAttribute('aria-pressed', String(current.maps));
    }
    render();

    toggleBtn?.addEventListener('click', () => {
      current = { ...current, maps: !current.maps };
      render();
    });

    document.getElementById('save-settings')?.addEventListener('click', () => {
      writeConsent(current);
      document.getElementById('save-confirmation')?.classList.remove('hidden');
    });

    document.getElementById('revoke-all')?.addEventListener('click', () => {
      current = { necessary: true, maps: false };
      render();
      writeConsent(current);
      document.getElementById('save-confirmation')?.classList.remove('hidden');
    });
  </script>
</Layout>
