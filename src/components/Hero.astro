---
// Hero: eigene Video-Sektion (Grid-Parallax + Cursor-Spotlight-Reveal) oben,
// Headline/Text/CTA in eigener Sektion darunter auf normalem Hintergrund —
// damit der Text nicht auf dem Video "schwimmt". Fade-Verlauf am unteren
// Video-Rand blendet weich in die Hintergrundfarbe der Textsektion über.
// Struktur/Interaktion aus dem Claude-Design-Export übernommen, Inhalte/
// Farben/Schrift unverändert aus dem bestehenden Designsystem.
import { business } from '../lib/site';
import { LiquidMetalButton } from './LiquidMetalButton';
---

<section
  id="hero"
  data-hero
  class="relative h-[75vh] min-h-[480px] overflow-hidden bg-ink"
  style="margin-top: calc(-1 * var(--navbar-height, 84px));"
>
  <!-- Dekoratives Grid, leicht parallax zur Cursor-Position -->
  <div class="pointer-events-none absolute -inset-10 z-0 overflow-hidden opacity-10">
    <svg data-hero-grid class="h-[calc(100%+80px)] w-[calc(100%+80px)] will-change-transform" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid-pattern" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="#b7afa7" stroke-width="0.6"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid-pattern)"></rect>
    </svg>
  </div>

  <!-- Basis-Video, gedämpft. Poster-Bild ist Frame 0 desselben Videos (per ffmpeg
       extrahiert) — optisch identisch zum Video-Start, kein sichtbarer Bildwechsel.
       Zusätzlich als eigenes <img> überlagert (statt nur poster-Attribut), damit
       ein echter CSS-Fade beim Wechsel zum Video möglich ist (siehe Script unten). -->
  <div class="pointer-events-none absolute inset-0 z-[1] overflow-hidden">
    <img
      data-hero-poster
      src="/images/hero-poster.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-[center_25%] transition-opacity duration-700 ease-out"
      style="filter: brightness(0.55) contrast(1.05) saturate(0.9);"
    />
    <video
      data-hero-video-base
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster="/images/hero-poster.jpg"
      class="absolute inset-0 h-full w-full object-cover object-[center_25%]"
      style="filter: brightness(0.55) contrast(1.05) saturate(0.9);"
    >
      <source src="/videos/hero-foam-droplet.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Spotlight-Reveal: hellere Video-Variante, nur im Cursor-Radius sichtbar (via Maske) -->
  <div
    data-hero-spotlight
    class="pointer-events-none absolute inset-0 z-[2] overflow-hidden will-change-[mask-image]"
  >
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster="/images/hero-poster.jpg"
      class="absolute inset-0 h-full w-full object-cover object-[center_25%]"
      style="filter: brightness(1.18) contrast(1.08) saturate(1.05);"
    >
      <source src="/videos/hero-foam-droplet.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Weicher Übergang unten: Video blendet in den Hintergrund der Textsektion über -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-[3] h-40 bg-gradient-to-b from-transparent to-ink"></div>
</section>

<section class="relative bg-ink px-4 pb-16 pt-10 sm:px-6">
  <div class="mx-auto w-full max-w-6xl">
    <h1 class="font-display text-5xl text-paper sm:text-6xl md:text-7xl">
      Barber Regensburg – Herrenfriseur und Bartpflege am Galgenberg
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-stone-200">
      Als Barber in Regensburg sitzen Sie bei uns schnell auf dem Stuhl – lange Wartezeit ist bei uns die
      Ausnahme. Am Galgenberg schneiden unsere Friseure Herren die Haare, pflegen den Bart und arbeiten von
      klassisch bis Taper Fade, auch spontan und ohne festen Termin.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <LiquidMetalButton
        client:idle
        label={`Jetzt anrufen: ${business.phone}`}
        href={`tel:${business.phoneHref.replace('tel:', '')}`}
        variant="dark"
      />
      <LiquidMetalButton client:idle label="Anfahrt & Öffnungszeiten" href="/kontakt" variant="dark" />
    </div>
  </div>
</section>

<script>
  // Vanilla-JS-Portierung des Spotlight-/Parallax-Effekts aus dem Design-Export
  // (dort React/Canvas). Reagiert auf Maus/Touch, respektiert prefers-reduced-motion:
  // dann bleibt die Spotlight-Maske aus und beide Video-Layer sind einfach sichtbar.
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const grid = section?.querySelector<SVGSVGElement>('[data-hero-grid]');
  const spotlight = section?.querySelector<HTMLElement>('[data-hero-spotlight]');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && grid && spotlight && !reduceMotion) {
    let target = { x: 0, y: 0 };
    let smooth = { x: 0, y: 0 };
    let gridPos = { x: 0, y: 0 };
    let initialized = false;
    const radius = 260;

    const setInitial = () => {
      const r = section.getBoundingClientRect();
      target = { x: r.width / 2, y: r.height * 0.65 };
      smooth = { ...target };
    };
    setInitial();
    window.addEventListener('resize', setInitial);

    const onPointerMove = (e: PointerEvent | Touch) => {
      const r = section.getBoundingClientRect();
      target = { x: e.clientX - r.left, y: e.clientY - r.top };
      if (!initialized) {
        smooth = { ...target };
        initialized = true;
      }
    };
    section.addEventListener('pointermove', (e) => onPointerMove(e));
    section.addEventListener(
      'touchmove',
      (e) => {
        if (e.touches[0]) onPointerMove(e.touches[0]);
      },
      { passive: true }
    );

    const loop = () => {
      smooth.x += (target.x - smooth.x) * 0.1;
      smooth.y += (target.y - smooth.y) * 0.1;

      const cx = section.clientWidth / 2;
      const cy = section.clientHeight / 2;
      const gx = ((target.x - cx) / (cx || 1)) * 16;
      const gy = ((target.y - cy) / (cy || 1)) * 16;
      gridPos.x += (gx - gridPos.x) * 0.06;
      gridPos.y += (gy - gridPos.y) * 0.06;
      grid.style.transform = `translate3d(${gridPos.x.toFixed(2)}px, ${gridPos.y.toFixed(2)}px, 0)`;

      const mask = `radial-gradient(circle ${radius}px at ${smooth.x.toFixed(1)}px ${smooth.y.toFixed(1)}px, rgba(255,255,255,1) 0%, rgba(255,255,255,1) 40%, rgba(255,255,255,0.75) 60%, rgba(255,255,255,0.55) 75%, rgba(255,255,255,0.25) 88%, rgba(255,255,255,0.08) 100%)`;
      spotlight.style.maskImage = mask;
      spotlight.style.webkitMaskImage = mask;

      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  } else if (spotlight) {
    // Ohne Animation: Spotlight-Layer einfach voll sichtbar lassen statt maskiert.
    spotlight.style.maskImage = 'none';
    spotlight.style.webkitMaskImage = 'none';
  }

  // Videos laufen bewusst gedrosselt (0.5x), wie im Design-Export.
  section?.querySelectorAll('video').forEach((v) => {
    v.playbackRate = 0.5;
    v.addEventListener('loadedmetadata', () => {
      v.playbackRate = 0.5;
    });
  });

  // Poster-Bild weich ausblenden, sobald das Basis-Video tatsächlich läuft
  // (nicht schon bei "geladen", sondern erst bei echtem Frame-Rendering) —
  // macht den Wechsel weich, falls die Verbindung langsam ist und der
  // Poster länger sichtbar bleibt als üblich.
  const posterImg = section?.querySelector<HTMLImageElement>('[data-hero-poster]');
  const baseVideo = section?.querySelector<HTMLVideoElement>('[data-hero-video-base]');
  if (posterImg && baseVideo) {
    const hidePoster = () => {
      posterImg.style.opacity = '0';
    };
    if (baseVideo.readyState >= 3) {
      hidePoster();
    } else {
      baseVideo.addEventListener('playing', hidePoster, { once: true });
    }
  }
</script>
