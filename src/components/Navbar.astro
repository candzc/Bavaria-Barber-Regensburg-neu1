---
// Zentrierte Pill-Navbar, fixed positioniert, dunkler Hintergrund (--color-ink).
// Ab 900px Desktop-Nav + CTA sichtbar, darunter Mobile-Toggle + Vollbild-Menü.
// Über der Hero-Videosektion (#hero, nur Startseite) transparent, sonst solide
// Pill — siehe Script unten (IntersectionObserver) und Kommentar bei .nav-on-hero.
import { mainNav, business } from '../lib/site';
import { LiquidMetalButton } from './LiquidMetalButton';
const currentPath = Astro.url.pathname;
---

<header data-navbar class="fixed inset-x-0 top-0 z-50 px-3 pt-3 transition-colors duration-300 sm:px-4 sm:pt-4">
  <div
    data-navbar-pill
    class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-paper/10 bg-ink/95 px-4 py-3 shadow-lg backdrop-blur transition-all duration-300 sm:px-6"
  >
    <a href="/" class="font-display text-lg font-semibold tracking-wide text-paper sm:text-xl">
      Bavaria
    </a>

    <nav aria-label="Hauptnavigation" class="hidden items-center gap-1 min-[900px]:flex">
      {mainNav.map((item) => (
        <a
          href={item.href}
          data-navbar-link
          class:list={[
            'relative px-3 py-1.5 text-sm font-medium tracking-wide text-paper/75 transition-colors duration-200 hover:text-paper',
            currentPath === item.href && 'text-paper',
          ]}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <div class="ml-3">
        <LiquidMetalButton
          client:idle
          label={business.phone}
          href={`tel:${business.phoneHref.replace('tel:', '')}`}
          variant="dark"
        />
      </div>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full text-paper transition-colors duration-200 hover:bg-paper/10 min-[900px]:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile Navigation" class="fixed inset-0 z-[60] hidden flex-col justify-center bg-ink px-8 min-[900px]:hidden">
    <button
      id="mobile-menu-close"
      type="button"
      class="absolute right-6 top-6 flex h-11 w-11 items-center justify-center rounded-full text-paper hover:bg-paper/10"
      aria-label="Menü schließen"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <ul class="flex flex-col items-center gap-6">
      {mainNav.map((item, i) => (
        <li data-mobile-link style={`transition-delay:${80 + i * 60}ms`}>
          <a href={item.href} class="text-3xl font-medium tracking-tight text-paper/90 transition-colors hover:text-paper">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div data-mobile-link style={`transition-delay:${80 + mainNav.length * 60}ms`} class="mt-10 flex justify-center">
      <LiquidMetalButton
        client:idle
        label={`Jetzt anrufen: ${business.phone}`}
        href={`tel:${business.phoneHref.replace('tel:', '')}`}
        variant="dark"
        className="w-full max-w-xs"
      />
    </div>
  </nav>
</header>

<style>
  /* Link-Hover-Animation: Unterstrich zieht sich beim Hover/aktiver Seite ein. */
  [data-navbar-link]::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 2px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s ease;
  }
  [data-navbar-link]:hover::after,
  [data-navbar-link][aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Mobile-Menü: Fade-in + gestaffeltes Einfliegen der Links, respektiert
     prefers-reduced-motion (siehe globaler .js-Umgang in global.css: hier
     zusätzlich direkt geprüft, weil das Menü kein .reveal-Element ist). */
  #mobile-menu {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }
  #mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }
  #mobile-menu [data-mobile-link] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  #mobile-menu.is-open [data-mobile-link] {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #mobile-menu [data-mobile-link] {
      transition: none;
    }
  }

  /* Transparente Navbar über dem Hero-Video (nur Startseite, siehe Script):
     Pill-Hintergrund/Rand/Schatten aus, Textfarben bleiben unverändert hell,
     da die Pill ohnehin permanent dunkel/hell-auf-dunkel gestaltet ist. */
  header.nav-on-hero [data-navbar-pill] {
    border-color: transparent;
    background-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  const openMenu = () => {
    menu?.classList.remove('hidden');
    menu?.classList.add('flex');
    requestAnimationFrame(() => menu?.classList.add('is-open'));
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Menü schließen');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  };
  const closeMenu = () => {
    menu?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Menü öffnen');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
    setTimeout(() => {
      if (!menu?.classList.contains('is-open')) {
        menu?.classList.add('hidden');
        menu?.classList.remove('flex');
      }
    }, 250);
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });
  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  // Navbar-Höhe als CSS-Variable bereitstellen: <main> nutzt sie als
  // padding-top (Layout.astro), die Hero-Sektion zieht sich per negativem
  // Margin exakt darunter (Hero.astro) — dieselbe Quelle für beide, damit
  // nichts auseinanderdriftet, egal wie hoch die Navbar tatsächlich ist.
  const header = document.querySelector<HTMLElement>('[data-navbar]');
  const setNavbarHeightVar = () => {
    if (!header) return;
    const h = header.getBoundingClientRect().height;
    if (h) document.documentElement.style.setProperty('--navbar-height', `${h}px`);
  };
  setNavbarHeightVar();
  window.addEventListener('resize', setNavbarHeightVar);

  // Transparente Navbar, solange der Video-Hero im Viewport ist; sobald er
  // durchgescrollt ist, zurück zur soliden Ink-Pill. Seiten ohne #hero
  // (Leistungen, Über uns, Kontakt, ...) sind davon nicht betroffen.
  const hero = document.getElementById('hero');
  if (header && hero && 'IntersectionObserver' in window) {
    const headerHeight = header.getBoundingClientRect().height || 80;
    const io = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('nav-on-hero', entry.isIntersecting);
      },
      { rootMargin: `-${Math.ceil(headerHeight)}px 0px 0px 0px`, threshold: 0 }
    );
    io.observe(hero);
  }
</script>
