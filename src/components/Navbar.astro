---
import { mainNav, business } from '../lib/site';
const currentPath = Astro.url.pathname;
---

<header data-navbar class="sticky top-0 z-40 px-3 pt-3 transition-colors duration-300 sm:px-4 sm:pt-4">
  <div
    data-navbar-pill
    class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-stone-200 bg-paper/95 px-4 py-3 shadow-sm backdrop-blur transition-all duration-300 sm:px-6"
  >
    <a data-navbar-logo href="/" class="font-display text-lg font-semibold tracking-wide text-ink transition-colors duration-300 sm:text-xl">
      Bavaria Barber <span data-navbar-accent class="text-wine transition-colors duration-300">Regensburg</span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden items-center gap-8 md:flex">
      {mainNav.map((item) => (
        <a
          href={item.href}
          data-navbar-link
          class:list={[
            'text-sm font-medium tracking-wide transition-colors duration-300 hover:text-wine',
            currentPath === item.href ? 'text-wine' : 'text-ink-soft',
          ]}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href={`tel:${business.phoneHref.replace('tel:', '')}`}
        class="inline-flex min-h-[44px] items-center rounded-full bg-wine px-5 text-sm font-semibold text-paper transition-colors hover:bg-wine-dark"
      >
        {business.phone}
      </a>
    </nav>

    <button
      id="menu-toggle"
      data-navbar-toggle
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full text-ink transition-colors duration-300 hover:bg-paper-dim md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile Navigation" class="hidden md:hidden">
    <ul class="mx-auto mt-2 flex max-w-6xl flex-col gap-1 rounded-2xl border border-stone-200 bg-paper px-4 py-3 shadow-sm">
      {mainNav.map((item) => (
        <li>
          <a href={item.href} class="block min-h-[48px] py-3 text-base font-medium text-ink-soft hover:text-wine">
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href={`tel:${business.phoneHref.replace('tel:', '')}`} class="mt-2 flex min-h-[48px] items-center justify-center rounded-full bg-wine px-5 text-sm font-semibold text-paper">
          Jetzt anrufen: {business.phone}
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  /* Transparente Navbar über dem Hero-Video: Pill-Optik/dunkle Schrift weicht
     hellem Kontrast auf transparentem Grund. Nur aktiv, solange #hero (Startseite)
     im Viewport ist — siehe Script unten. Andere Seiten ohne #hero bleiben bei
     der normalen Pill-Navbar, keine Verhaltensänderung dort. */
  header.nav-on-hero [data-navbar-pill] {
    border-color: transparent;
    background-color: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }
  header.nav-on-hero [data-navbar-logo] {
    color: var(--color-paper);
  }
  header.nav-on-hero [data-navbar-accent] {
    color: var(--color-wine-soft);
  }
  header.nav-on-hero [data-navbar-link] {
    color: rgba(255, 255, 255, 0.85);
  }
  header.nav-on-hero [data-navbar-link]:hover {
    color: var(--color-paper);
  }
  header.nav-on-hero [data-navbar-link][aria-current='page'] {
    color: var(--color-paper);
  }
  header.nav-on-hero [data-navbar-toggle] {
    color: var(--color-paper);
  }
  header.nav-on-hero [data-navbar-toggle]:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen');
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  // Navbar-Höhe als CSS-Variable bereitstellen: die Hero-Sektion zieht sich
  // damit exakt um diesen Betrag nach oben, unter die (sticky, aber leere/
  // transparente) Navbar — sonst bliebe dort eine helle Lücke vor dem Video.
  const header = document.querySelector<HTMLElement>('[data-navbar]');
  const setNavbarHeightVar = () => {
    if (!header) return;
    const h = header.getBoundingClientRect().height;
    if (h) document.documentElement.style.setProperty('--navbar-height', `${h}px`);
  };
  setNavbarHeightVar();
  window.addEventListener('resize', setNavbarHeightVar);

  // Transparente Navbar, solange der Video-Hero im Viewport ist; sobald er
  // durchgescrollt ist, zurück zur weißen Pill-Optik. Seiten ohne #hero
  // (Leistungen, Über uns, Kontakt, ...) sind davon nicht betroffen.
  const hero = document.getElementById('hero');
  if (header && hero && 'IntersectionObserver' in window) {
    const headerHeight = header.getBoundingClientRect().height || 80;
    const io = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('nav-on-hero', entry.isIntersecting);
      },
      { rootMargin: `-${Math.ceil(headerHeight)}px 0px 0px 0px`, threshold: 0 }
    );
    io.observe(hero);
  }
</script>
